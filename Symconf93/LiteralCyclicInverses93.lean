namespace ModCount49

def invC (i : Fin 2) : ℤ := (#[89, 98701] : Array ℤ)[i.val]!
def invW (i : Fin 2) : ℕ := (#[5, 4] : Array ℕ)[i.val]!

def invRow (i : Fin 2) (b : Fin (profile i).length) (j : Fin ((profile i).get b)) : ℤ :=
  let L := (profile i).get b
  (700*invC i / greenDen L)*(greenNum L)[j.val]!

theorem inv_card : ∀ i : Fin 2, Fintype.card (BlocksOf (profile i))=93 := by
  decide +kernel

theorem inv_sum : ∀ (i : Fin 2) (b : Fin (profile i).length),
    (∑ j, invRow i b j) = 100*invC i := by
  decide +kernel

theorem inv_step : ∀ (i : Fin 2) (b : Fin (profile i).length)
    (j : Fin ((profile i).get b)),
    9*invRow i b j - invRow i b (Symconf59.cprev j) - invRow i b (Symconf59.cnext j) =
      if j.val=0 then 700*invC i else 0 := by
  decide +kernel

def actual_inverse (i : Fin 2) : CyclicInverse93 (profile i) :=
  ⟨invC i, invRow i, inv_card i, inv_sum i, inv_step i⟩

theorem actual_inverse_nonzero : ∀ i : Fin 2, 700*invC i ≠ 0 := by decide +kernel
theorem actual_inverse_modulus : ∀ i : Fin 2,
    (invW i:ZMod 49)*((700*invC i:ℤ):ZMod 49)=7 := by decide +kernel

end ModCount49

#print axioms ModCount49.actual_inverse
#print axioms ModCount49.actual_inverse_nonzero
#print axioms ModCount49.actual_inverse_modulus

