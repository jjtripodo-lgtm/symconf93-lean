theorem double_cell_row01 (v : Fin 31) (h : 1<v.val) : CellCovers31 1 v.val := by
  fin_cases v
  · change 1<0 at h; omega
  · change 1<1 at h; omega
  · exact c01_02
  · exact c01_03
  · exact c01_04
  · exact c01_05
  · exact c01_06
  · exact c01_07
  · exact c01_08
